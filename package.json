{
  "name": "e-menu-be",
  "version": "1.0.0",
  "description": "",
  "main": "app.ts",
  "scripts": {
    "prebuild": "npm run clean:build",
    "dev": "npm run db:generate && cross-env NODE_ENV=development nodemon .",
    "build:production": "npm run db:generate && tsc --build tsconfig.build.json && tsc-alias -p tsconfig.json",
    "production": "npm run build:production && npm run start",
    "start": "cross-env NODE_ENV=production node ./build/app.js",
    "clean:build": "rm -rf build",
    "env-dev": "dotenv -e .env.dev --",
    "prisma:format": "npx prisma format",
    "db:push": "npx prisma db push",
    "db:pull": "npx prisma db pull",
    "db:generate": "npx prisma generate",
    "db:migrate": "npm run env-dev npx prisma migrate dev --name init",
    "db:studio": "npm run env-dev npx prisma studio",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "./app/prisma/schema.prisma"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.15.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "http-status": "^1.7.4",
    "joi": "^17.13.2",
    "morgan": "^1.10.0",
    "nocache": "^4.0.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.6.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "cross-env": "^7.0.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "nodemon": "^3.1.3",
    "prettier": "3.3.2",
    "prisma": "^5.15.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
