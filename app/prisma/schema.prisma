generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Table {
  id           Int        @id @default(autoincrement())
  session      String?    @unique
  ipAddress    String     @unique @db.Char(60)
  tableNo      Int
  status       Boolean    @default(false)
  approvedDate DateTime?  @db.DateTime(0)
  approvedBy   String?    @db.Char(50)
  createdAt    DateTime   @default(now()) @db.DateTime(0)
  updatedAt    DateTime?  @updatedAt
  customers    Customer[]
}

model Customer {
  id         String       @unique @default(uuid())
  name       String       @unique @db.VarChar(255)
  role       CustomerType @default(ACCOMPLICE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  leaderId   String?
  tableId    Int
  cart       Cart?
  leader     Customer?    @relation("group", fields: [leaderId], references: [id])
  accomplice Customer[]   @relation("group")
  table      Table        @relation(fields: [tableId], references: [id])

  @@index([leaderId], map: "Customer_leaderId_fkey")
  @@index([tableId], map: "Customer_tableId_fkey")
}

model Cart {
  id         String   @unique @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model CartItem {
  sessionId String   @db.Char(200)
  tableNo   Int
  productId String   @db.Char(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quantity  Int
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([sessionId, tableNo, productId])
  @@index([productId], map: "CartItem_productId_fkey")
}

model Product {
  id                      String              @unique @default(uuid())
  name                    String
  image                   String              @db.LongText
  description             String              @db.LongText
  price                   Float
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  estimatedCookingTimeMin Int
  cartItems               CartItem[]
  orders                  Orders[]
  productCategorize       ProductCategorize[]
  productReview           ProductReview[]
  inventory               Inventory?
}

model ProductCategory {
  id                  String                @unique @default(uuid())
  name                String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  productCategorize   ProductCategorize[]
  promotionCategorize PromotionCategorize[]
}

model ProductCategorize {
  categoryId String
  productId  String
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])

  @@unique([categoryId, productId])
  @@index([productId], map: "ProductCategorize_productId_fkey")
}

model Promotion {
  id                  String                @unique @default(uuid())
  name                String
  description         String                @db.LongText
  discountRate        Float
  startDate           DateTime              @default(now())
  endDate             DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  promotionCategorize PromotionCategorize[]
}

model PromotionCategorize {
  categoryId  String
  promotionId String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  promotion   Promotion       @relation(fields: [promotionId], references: [id])

  @@unique([categoryId, promotionId])
  @@index([promotionId], map: "PromotionCategorize_promotionId_fkey")
}

model ProductReview {
  id        String   @unique @default(uuid())
  comment   String   @db.LongText
  rating    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accountId String
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@index([accountId], map: "ProductReview_accountId_fkey")
  @@index([productId], map: "ProductReview_productId_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model Loyalty {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(50)
  amount    Float    @db.Float
  reference String   @db.Char(200)
  createdAt DateTime @default(now())
  contactNo String   @db.VarChar(50)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Orders {
  id            Int      @id @default(autoincrement())
  sessionId     String   @db.Char(200)
  tableNo       Int
  productId     String
  price         Float    @db.Float
  quantity      Int
  amount        Float    @db.Float
  createdAt     DateTime @default(now()) @db.DateTime(0)
  transactionId String   @db.Char(200)
  orderNo       Int
  product       Product  @relation(fields: [productId], references: [id], onUpdate: Restrict, map: "Orders_product_fkey")

  @@index([productId], map: "Orders_product_fkey")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Transactions {
  id            Int                        @id @default(autoincrement())
  sessionId     String                     @db.Char(200)
  tableNo       Int
  amount        Float                      @db.Float
  paymentMethod Transactions_paymentMethod
  paymentMode   String?
  transactionId String                     @unique @db.Char(200)
  email         String?                    @db.VarChar(50)
  name          String?                    @db.VarChar(50)
  contactNo     String?                    @db.VarChar(50)
  loyalty       Boolean                    @default(false)
  status        Transactions_status        @default(PENDING)
  paymentStatus Transactions_paymentStatus @default(UNPAID)
  createdAt     DateTime                   @default(now()) @db.DateTime(0)
  updatedAt     DateTime                   @updatedAt
  updatedBy     String?                    @db.VarChar(50)
  orderNo       Int                        @unique
}

model User {
  id        String    @unique(map: "Account_id_key") @default(uuid())
  name      String
  email     String    @unique(map: "Account_email_key") @db.VarChar(255)
  contact   String
  password  String
  sessionId String?   @unique @db.Char(200)
  role      User_Role
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Inventory {
  id        Int                @id @default(autoincrement())
  productId String             @unique
  quantity  Int                @default(15)
  updatedAt DateTime           @updatedAt

  product   Product  @relation(fields: [productId], references: [id])
}

model Debit {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(50)
  contactNo String?   @db.VarChar(50)
  rewardId  Int
  amount    Int
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt
  reward    Reward   @relation(fields: [rewardId], references: [id])

  @@index([rewardId], map: "Debit_rewardId_fkey")
}

model Reward {
  id        Int      @id @default(autoincrement())
  rewardId  String   @unique @default(uuid())
  name      String   @db.VarChar(100)
  points    Int
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt
  debit     Debit[]
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(50)
  code      Int
  sessionId String?  @db.Char(200)
  createdAt DateTime @default(now())
}

model Assistance {
  id           Int      @id @default(autoincrement())
  requested    String   @unique
  tableNo      Int
  assist       Boolean  @default(false)
  approvedDate DateTime?@db.DateTime(0)
  approvedBy   String?  @db.Char(50)
  createdAt    DateTime @default(now())
}

enum InventoryItemCategory {
  MEAT
  PRODUCE
  DAIRY
  SEAFOOD
}

enum CustomerType {
  LEADER
  ACCOMPLICE
}

enum User_Role {
  ADMIN
  KITCHEN
  CASHIER
  WAITER
  CUSTOMER
}

enum Transactions_paymentMethod {
  CASH
  ONLINE
}

enum Transactions_status {
  PENDING
  ONGOING
  SERVED
  COMPLETED
  CANCELLED
}

enum Transactions_paymentStatus {
  PAID
  UNPAID
}