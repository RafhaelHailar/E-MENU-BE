generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Account {
  id            String          @unique @default(uuid())
  name          String
  email         String          @unique @db.VarChar(255)
  contact       String
  password      String
  status        Boolean
  remarks       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  productReview ProductReview[]
}

model Table {
  id           Int        @id @default(autoincrement())
  session      String?    @unique
  ipAddress    String     @unique @db.Char(60)
  tableNo      Int
  status       Boolean    @default(false)
  approvedDate DateTime?  @db.DateTime(0)
  approvedBy   String?    @db.Char(50)
  createdAt    DateTime   @default(now()) @db.DateTime(0)
  updatedAt    DateTime?  @db.DateTime(0)
  customers    Customer[]
}

model Customer {
  id         String       @unique @default(uuid())
  name       String       @unique @db.VarChar(255)
  role       CustomerType @default(ACCOMPLICE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  leaderId   String?
  tableId    Int
  cart       Cart?
  leader     Customer?    @relation("group", fields: [leaderId], references: [id])
  accomplice Customer[]   @relation("group")
  table      Table        @relation(fields: [tableId], references: [id])

  @@index([leaderId], map: "Customer_leaderId_fkey")
  @@index([tableId], map: "Customer_tableId_fkey")
}

model Cart {
  id         String   @unique @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])
}

model CartItem {
  id        Int      @unique @default(autoincrement())
  sessionId String   @db.Char(200)
  tableNo   Int
  productId String   @db.Char(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quantity  Int
  product   Product  @relation(fields: [productId], references: [id], onUpdate: Restrict, map: "product_fk")

  @@index([productId], map: "product_fk")
}

model Product {
  id                      String              @unique @default(uuid())
  name                    String
  image                   String              @db.LongText
  description             String              @db.LongText
  price                   Float
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  estimatedCookingTimeMin Int
  CartItem                CartItem[]
  productCategorize       ProductCategorize[]
  productReview           ProductReview[]
}

model ProductCategory {
  id                  String                @unique @default(uuid())
  name                String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  productCategorize   ProductCategorize[]
  promotionCategorize PromotionCategorize[]
}

model ProductCategorize {
  categoryId String
  productId  String
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])

  @@unique([categoryId, productId])
  @@index([productId], map: "ProductCategorize_productId_fkey")
}

model Promotion {
  id                  String                @unique @default(uuid())
  name                String
  description         String                @db.LongText
  discountRate        Float
  startDate           DateTime              @default(now())
  endDate             DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  promotionCategorize PromotionCategorize[]
}

model PromotionCategorize {
  categoryId  String
  promotionId String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  promotion   Promotion       @relation(fields: [promotionId], references: [id])

  @@unique([categoryId, promotionId])
  @@index([promotionId], map: "PromotionCategorize_promotionId_fkey")
}

model ProductReview {
  id        String   @unique @default(uuid())
  comment   String   @db.LongText
  rating    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accountId String
  productId String
  account   Account  @relation(fields: [accountId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@index([accountId], map: "ProductReview_accountId_fkey")
  @@index([productId], map: "ProductReview_productId_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum CustomerType {
  LEADER
  ACCOMPLICE
}
